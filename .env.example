# Netlify → Site configuration → Environment variables. Never commit real values.
# Supabase (new project for Gainora Agents)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (Anthropic recommended; supports web search for The Scout)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5         # research (The Scout)
# AI_FAST_MODEL=claude-haiku-5-5     # chat, Brief, intros, Watcher summaries
# AI_MONTHLY_CAP_USD=8               # per client, fails closed when reached
# Or OpenAI instead: AI_PROVIDER=openai, OPENAI_API_KEY=..., AI_MODEL=...

# Google (The Watcher: reviews, competitors' ratings and the speed test)
# Enable "Places API (New)" and "PageSpeed Insights API", and restrict the key to those two.
GOOGLE_API_KEY=
# PLACES_MONTHLY_CAP=90              # Places calls per client per month for the competition (nearby search by type and phrase, ratings)

# Instagram (optional; nothing shows until the first two are set). See META-SETUP.md.
# Gainora's own Instagram professional account id and a long-lived token for Gainora's own Meta app.
META_IG_USER_ID=
META_ACCESS_TOKEN=
# META_APP_ID=                       # only to refresh a long-lived User token automatically (not needed for a Page token)
# META_APP_SECRET=
# META_DAILY_CAP=150                 # Business Discovery calls a day across all clients
# META_PER_CLIENT_CAP=10             # accounts read per client per day

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Which Stripe product unlocks which agents. "all" = Gainora Command Centre (all three agents).
# Replace prod_COMMAND_CENTRE with your Command Centre product ID. The old single-agent products can stay listed.
STRIPE_AGENT_PRODUCTS={"prod_COMMAND_CENTRE":"all","prod_VYEmpgmYPmGo7m":"watcher","prod_VYEqjXnYCDIdLe":"scout","prod_VYEkd4LmdrDnmz":"brief"}

# Email (Resend) — welcome emails, weekly summaries and the monthly results email
RESEND_API_KEY=
EMAIL_FROM=Gainora <hello@gainora.co.uk>

# Text messages to the owner's clients (optional; off by default). Without these, the app's only sending mode is
# "Send from your phone": it opens the owner's messages app with the approved text, and the owner presses send.
# To let Gainora send approved texts itself, connect Twilio: all four must be set or nothing is sent.
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=                        # a UK number you own on Twilio, or an alphanumeric sender id (the clinic's name, up to 11 characters)

# App
APP_URL=https://app.gainora.co.uk
INTERNAL_SECRET=    # any long random string; protects the background functions
